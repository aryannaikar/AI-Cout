# AI Court of India — Environment Configuration Example
# Copy this file to .env and configure your credentials.

# Centralized LLM Provider ('ollama' or 'nvidia')
LLM_PROVIDER=ollama

# Ollama Configuration (Primary Local Brain)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# NVIDIA API Configuration (Cloud Model Provider)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
